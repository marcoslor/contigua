<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app stays unsandboxed; the group is only there so the control
	     extension's container and the bridge socket are the same directory. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.contigua.mac.controls</string>
	</array>
</dict>
</plist>
