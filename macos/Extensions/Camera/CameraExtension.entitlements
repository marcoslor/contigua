<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Camera extensions must be sandboxed or the system refuses to run them.
	     The App Group is shared with the containing app; Apple's guidance is
	     that its identifier starts with the extension's MachServiceName. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__CAMERA_GROUP__</string>
	</array>
</dict>
</plist>
