<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the app may hand out as app.contigua.fileprovider URIs
     (docs/design/dragdrop.md). Both a drop's SEND and a clipboard image share
     only app-owned copies under cache/: the shell never serves a path it wrote.
     The card at large is never addressable. -->
<paths>
    <cache-path name="shared" path="shared/" />
    <cache-path name="clip" path="clip/" />
</paths>
