<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the test notification poster the emulator/E2E checks
     drive from adb (docs/design/notify.md). Release builds never see it.
     DUMP is held by the shell (adb) and by no ordinary app, so no other app
     on a phone running a debug build can make PocketDeck post. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="dev.pocketdeck.app.NotifyDebugPoster"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.pocketdeck.DEBUG_NOTIFY" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="dev.pocketdeck.app.NotifyDebugResult"
            android:exported="false" />
    </application>
</manifest>
