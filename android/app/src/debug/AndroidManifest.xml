<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the test notification poster and the media-session
     fakes the emulator/E2E checks drive from adb (docs/design/notify.md).
     Release builds never see any of it. DUMP is held by the shell (adb) and by
     no ordinary app, so no other app on a phone running a debug build can make
     PocketDeck post a notification or send it a stage. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- ISS-51: a share target's picker started from an application
             context. Debug builds only; the emulator check drives them.
             Disabled by default: the person's phone runs debug builds, and an
             enabled SEND filter would put a test target in every share sheet.
             tools/emulator/share-display.sh runs `pm enable` on them. -->
        <activity
            android:name="dev.pocketdeck.app.ShareDebugActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@style/Theme.PocketDeck" />
        <activity
            android:name="dev.pocketdeck.app.ShareDebugSendActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@style/Theme.PocketDeck">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <!-- Empty affinity: a share target's picker gets its own task, so a
             launch with no calling activity has no task to reuse and the
             system has to choose a display for it. -->
        <activity
            android:name="dev.pocketdeck.app.ShareDebugPickerActivity"
            android:enabled="false"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.PocketDeck" />

        <!-- A2's two fields (SHARE-16): a plain EditText and one whose
             OnReceiveContentListener takes image/*. Debug builds only; the
             checks drive it from adb, so it is exported. -->
        <activity
            android:name="dev.pocketdeck.app.PasteDebugActivity"
            android:exported="true"
            android:theme="@style/Theme.PocketDeck" />
        <receiver
            android:name="dev.pocketdeck.app.NotifyDebugPoster"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.pocketdeck.DEBUG_NOTIFY" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="dev.pocketdeck.app.NotifyDebugResult"
            android:exported="false" />

        <!-- One or two fake media sessions (artwork, seek, volume, choosing
             between apps), driven from adb like the poster above. -->
        <receiver
            android:name="dev.pocketdeck.app.MediaDebugTrigger"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.pocketdeck.DEBUG_MEDIA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
