<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only controls of the direct build (the reviewer's real-phone proof).
     Release builds and every public build never see this overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Started by the reviewer with `am start -n dev.pocketdeck/.direct.DirectDebugActivity`
             and an `op` string extra. DUMP is held by the shell (adb) and no
             ordinary app. -->
        <activity
            android:name="dev.pocketdeck.direct.DirectDebugActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
